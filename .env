# Shared Key-Value Store: Local Development Environment Variables

# Active backend store type: redis or dynamodb
STORE_TYPE=redis
VENDOR_NAME=myorg
API_PORT=8080

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_SSL=false
REDIS_DB=0
# REDIS_USERNAME=
# REDIS_PASSWORD=

# DynamoDB Configuration
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE_NAME=shared-store-local
DYNAMODB_PORT=8000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=localdev
AWS_SECRET_ACCESS_KEY=localdev
